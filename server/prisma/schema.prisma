generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime

  @@index([userId])
}

enum ArtworkGroup {
  PAINTING_AND_WALL_ART // Картины-живопись, Акварель, Стено-роспись, Рельеф
  GRAPHICS_AND_PRINTS // Литографии, Рисунки, Станковая-графика, Уникальная графика
  DESIGN_AND_ADVERTISING // Фирменные стили, Плакаты, Проекты, Реклама, Сувениры
  SUBJECTS_AND_THEMES // Портреты, Архитектура, Сюжеты, Пейзажи
}

enum ArtworkCategory {
  PAINTING
  WATERCOLOR
  WALL_PAINTING
  RELIEF

  LITHOGRAPHY
  DRAWING
  EASEL_GRAPHICS
  UNIQUE_GRAPHICS

  BRAND_IDENTITY
  POSTER
  PROJECT
  ADVERTISING

  PORTRAIT
  ARCHITECTURE
  SUBJECT
  LANDSCAPE
}

model Artwork {
  id          String  @id @default(uuid())
  title       String
   
        String
  slug        String  @unique // SEO и красивые URL
  description String?
  year        Int?
  widthCm     Int?
  heightCm    Int?
  materials   String?
  priceCents  Int? //  корректное хранение денег
  currency    String? @default("EUR") //  мультивалютность

  artworkGroup    ArtworkGroup?
  category ArtworkCategory

  isPublished Boolean @default(false) // черновики и управление видимостью
  image Image?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id String @id @default(uuid())

  // для S3/R2/MinIO
  key       String  @unique // например: "artworks/<artworkId>/<uuid>.jpg"
  url       String
  mimeType  String?
  sizeBytes Int?
  widthPx   Int?
  heightPx  Int?

  // связь с Artwork (много изображений на одну картину)
  artworkId String  @unique // в столбце artworkId таблицы Image не может быть дубликатов
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

 

model Publication {
  id          String           @id @default(uuid())
  type        PublicationType

  title       String?
  titleEn     String?
  slug        String?          @unique

  body        String?          @db.Text
  bodyEn      String?          @db.Text

  quoteText   String?          @db.Text
  quoteTextEn String?          @db.Text

  isPublished Boolean          @default(false)
  publishedAt DateTime?

  coverImage  PublicationImage?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, isPublished, publishedAt])
}

model PublicationImage {
  id            String       @id @default(uuid())

  key           String       @unique
  url           String
  
  publicationId String       @unique
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())
}
